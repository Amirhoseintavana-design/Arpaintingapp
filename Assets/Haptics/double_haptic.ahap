          { "ParameterID": "AttackTime", "ParameterValue": 0.0 },
          { "ParameterID": "DecayTime", "ParameterValue": 0.0 },
          { "ParameterID": "ReleaseTime", "ParameterValue": 0.0 },
          { "ParameterID": "Sustained", "ParameterValue": 1 }
        ]
      }
    },
    {
      "ParameterCurve": {
        "ParameterID": "HapticIntensityControl",
        "Time": 0,
        "ParameterCurveControlPoints": [
          { "Time": 0.0,  "ParameterValue": 0.2 },
          { "Time": 0.04, "ParameterValue": 0.2 },
          { "Time": 0.05, "ParameterValue": 1.0 },
          { "Time": 0.09, "ParameterValue": 0.9 },
          { "Time": 0.22, "ParameterValue": 0.45 },
          { "Time": 0.5,  "ParameterValue": 0.0 }
        ]
      }
    },
    {
      "ParameterCurve": {
        "ParameterID": "HapticSharpnessControl",
        "Time": 0,
        "ParameterCurveControlPoints": [
          { "Time": 0.0,  "ParameterValue": 0.05 },
          { "Time": 0.05, "ParameterValue": 0.0 },
          { "Time": 0.22, "ParameterValue": -0.15 },
          { "Time": 0.5,  "ParameterValue": -0.25 }
        ]
      }
    },
    {
